{
  "name": "style-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "prek install --allow-missing-config"
  },
  "devDependencies": {
    "@j178/prek": "0.5.9",
    "oxfmt": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
